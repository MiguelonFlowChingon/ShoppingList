rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only lists/<secret>/items/<id> exists. Nobody can browse the "lists" collection,
    // so a list can only be opened by someone who has its long secret link.
    match /lists/{listId}/items/{itemId} {
      function okList() {
        return listId.matches('^[A-Za-z0-9]{20,40}$');
      }
      function okItem() {
        return request.resource.data.keys().hasOnly(['name','qty','cat','addedBy','addedAt','bought','boughtBy','boughtAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.qty is string
          && request.resource.data.qty.size() <= 20
          && request.resource.data.cat is string
          && request.resource.data.cat.size() <= 20
          && request.resource.data.addedBy is string
          && request.resource.data.addedBy.size() <= 30
          && request.resource.data.boughtBy is string
          && request.resource.data.boughtBy.size() <= 30
          && request.resource.data.addedAt is number
          && request.resource.data.boughtAt is number
          && request.resource.data.bought is bool;
      }
      allow read: if okList();
      allow create, update: if okList() && okItem();
      allow delete: if okList();
    }
  }
}
